.checklistItem {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 16px;
    background-color: var(--bg-surface);
    border-radius: 8px;
    border: 1px solid var(--color-border);
    transition: all 0.15s ease;

    &:hover {
        border-color: var(--color-primary);
        background-color: var(--bg-hover);
    }
}

.iconContainer {
    flex-shrink: 0;
    margin-top: 2px;
}

.iconPass {
    color: var(--color-success, #2E8B57);
}

.iconWarn {
    color: var(--color-warning, #DAA520);
}

.iconFail {
    color: var(--color-error, #B22222);
}

.content {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.label {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-primary);
}

.note {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.4;
}